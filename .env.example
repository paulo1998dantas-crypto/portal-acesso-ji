# Banco compartilhado, usado somente pelo backend do Portal.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Gere valores longos e aleatórios. Nunca reutilize segredos já expostos.
PORTAL_SESSION_SECRET=troque-por-um-segredo-aleatorio
# Deve ser idêntico nos quatro módulos de destino.
ERP_PORTAL_SSO_SECRET=troque-por-um-segredo-compartilhado-aleatorio
PORTAL_COOKIE_SECURE=1
